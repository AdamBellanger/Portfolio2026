# Contact form: messages are emailed to you over SMTP.
# Gmail: enable 2-step verification, then create an app password at
# https://myaccount.google.com/apppasswords and paste it below (no spaces).
# Leave SMTP_USER / SMTP_PASS empty and the form opens the visitor's mail client instead.
SMTP_USER=
SMTP_PASS=
# Optional (defaults shown): Gmail over TLS, delivered to the address in content/site.ts.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# CONTACT_TO=
